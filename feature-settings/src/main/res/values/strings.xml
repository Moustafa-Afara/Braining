    <!-- M5 · first-run flow (ANSWERS.md Part 3 §A/§B, Part 11 §K4). -->
    <!-- The name is NOT written here. `%1$s` is core-ui's `app_name`, so this greeting says
         «فهم» on an Arabic phone and «Braining» on an English one without a second string to
         keep in step. -->
    <string name="onboarding_title">أهلاً بك في %1$s</string>
    <string name="onboarding_what">تحدّث بفكرتك بالعربية، فيستجوبك التطبيق حتى تنضج، ثم يصوغها برومبت احترافياً وينفّذه ويعيد لك الجواب بالعربية.</string>
    <string name="onboarding_why_key">يحتاج التطبيق مفتاحاً واحداً على الأقل من إحدى خدمات الذكاء الاصطناعي. المفتاح يبقى مشفَّراً على هاتفك ولا يغادره إلا إلى خدمته.</string>
    <string name="onboarding_where_gemini">Google Gemini — فيه خطّة مجانية بلا بطاقة ائتمان. احصل على المفتاح من موقع Google AI Studio.</string>
    <string name="onboarding_where_anthropic">Claude — من لوحة تحكّم Anthropic، قسم API Keys. مدفوع.</string>
    <string name="onboarding_where_openai">ChatGPT — من لوحة تحكّم OpenAI، قسم API keys. مدفوع.</string>
    <string name="onboarding_where_deepseek">DeepSeek — من منصّة DeepSeek، قسم API keys. مدفوع وزهيد الكلفة.</string>
    <string name="onboarding_gemini_region">تنبيه: ترفض Gemini الطلبات من بعض الدول برسالة «المنطقة غير مدعومة». إن حدث ذلك معك فاختر مزوّداً آخر من الأعلى — التطبيق يعمل بأي منها.</string>
    <string name="onboarding_privacy">لا يُحفظ صوتك أبداً. جلساتك تُحفظ على جهازك وحده، ويمكنك حذفها متى شئت من الإعدادات.</string>
    <string name="onboarding_start">ابدأ</string>
    <string name="onboarding_skip">تخطَّ الآن</string>
